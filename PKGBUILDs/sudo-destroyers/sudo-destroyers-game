#!/usr/bin/env bash

# sudo-destroyers - harmless terminal RPG
VERSION='2.0'
SAVE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sudo-destroyers"
SAVE_FILE="$SAVE_DIR/save.dat"

mkdir -p "$SAVE_DIR" 2>/dev/null || {
    printf 'sudo-destroyers: could not create save directory: %s\n' "$SAVE_DIR" >&2
    exit 1
}

# ANSI helpers. Everything is local to the game; no system commands are executed.
bold=$'\033[1m'
cyan=$'\033[1;36m'
yellow=$'\033[1;33m'
green=$'\033[1;32m'
red=$'\033[1;31m'
magenta=$'\033[1;35m'
reset=$'\033[0m'

VERSION='2.0'
player_name='Operator'
level=1
xp=0
score=0
coins=0
health=100
max_health=100
potions=2
weapon_level=1
round=1
wins=0

XP_PER_LEVEL=100

print_banner() {
    clear 2>/dev/null || true
    printf '%s\n' "${cyan}${bold}╔══════════════════════════════════════════════╗${reset}"
    printf '%s\n' "${cyan}${bold}║              S U D O  D E S T R O Y E R S    ║${reset}"
    printf '%s\n' "${cyan}${bold}║                 TERMINAL RPG v${VERSION}       ║${reset}"
    printf '%s\n' "${cyan}${bold}╚══════════════════════════════════════════════╝${reset}"
}

pause_game() {
    printf '\nPress Enter to continue...'
    IFS= read -r _ || true
}

xp_needed() {
    printf '%d' $((XP_PER_LEVEL + (level - 1) * 50))
}

level_up_check() {
    local needed
    while (( xp >= $(xp_needed) )); do
        needed=$(xp_needed)
        xp=$((xp - needed))
        level=$((level + 1))
        max_health=$((max_health + 12))
        health=$max_health
        weapon_level=$((weapon_level + 1))
        potions=$((potions + 1))
        printf '\n%s★ LEVEL UP! You reached level %d! ★%s\n' "$yellow" "$level" "$reset"
        printf 'Max HP increased to %d. Weapon level is now %d.\n' "$max_health" "$weapon_level"
    done
}

save_game() {
    umask 077
    local tmp="$SAVE_FILE.tmp"
    cat > "$tmp" <<EOF
player_name=$(printf '%q' "$player_name")
level=$level
xp=$xp
score=$score
coins=$coins
health=$health
max_health=$max_health
potions=$potions
weapon_level=$weapon_level
round=$round
wins=$wins
EOF
    mv "$tmp" "$SAVE_FILE"
    printf '%sGame saved to %s%s\n' "$green" "$SAVE_FILE" "$reset"
}

load_game() {
    [[ -f "$SAVE_FILE" ]] || return 1
    # Save files are generated by this game and contain only simple assignments.
    # shellcheck disable=SC1090
    source "$SAVE_FILE"
    return 0
}

new_game() {
    player_name='Operator'
    level=1
    xp=0
    score=0
    coins=0
    health=100
    max_health=100
    potions=2
    weapon_level=1
    round=1
    wins=0
    printf 'Enter your operator name: '
    IFS= read -r name
    [[ -n "$name" ]] && player_name="${name:0:24}"
}

show_status() {
    printf '\n%s=== OPERATOR STATUS ===%s\n' "$cyan" "$reset"
    printf 'Name:          %s\n' "$player_name"
    printf 'Level:         %d\n' "$level"
    printf 'XP:            %d / %d\n' "$xp" "$(xp_needed)"
    printf 'HP:            %d / %d\n' "$health" "$max_health"
    printf 'Weapon Level:  %d\n' "$weapon_level"
    printf 'Potions:       %d\n' "$potions"
    printf 'Credits:       %d\n' "$coins"
    printf 'Score:         %d\n' "$score"
    printf 'Victories:     %d\n' "$wins"
    printf 'Save:          %s\n' "$SAVE_FILE"
}

show_enemies() {
    printf '\n%s=== ENEMY DATABASE ===%s\n' "$magenta" "$reset"
    printf '%-22s %-8s %-8s %s\n' 'Enemy' 'HP' 'Attack' 'Reward'
    printf '%-22s %-8s %-8s %s\n' 'Permission Phantom' '45+' '6-13' 'XP + Credits'
    printf '%-22s %-8s %-8s %s\n' 'Root Raider' '60+' '8-16' 'XP + Credits'
    printf '%-22s %-8s %-8s %s\n' 'Sudo Destroyer' '75+' '10-19' 'XP + Credits'
    printf '%-22s %-8s %-8s %s\n' 'Kernel Knight' '95+' '12-22' 'XP + Credits'
    printf '%-22s %-8s %-8s %s\n' 'Terminal Titan' '120+' '14-25' 'XP + Credits'
    printf '\nAll combat is fictional and simulated.\n'
}

attack_enemy() {
    local damage=$((12 + RANDOM % 13 + weapon_level * 3))
    enemy_hp=$((enemy_hp - damage))
    (( enemy_hp < 0 )) && enemy_hp=0
    printf '%s⚔ ATTACK!%s You deal %d simulated damage. Enemy HP: %d\n' "$green" "$reset" "$damage" "$enemy_hp"
}

defend() {
    defending=1
    printf '%s🛡 DEFEND!%s Incoming damage will be reduced this turn.\n' "$cyan" "$reset"
}

use_potion() {
    if (( potions <= 0 )); then
        printf '%sNo potions left!%s\n' "$red" "$reset"
        return
    fi
    if (( health >= max_health )); then
        printf 'Your HP is already full.\n'
        return
    fi
    potions=$((potions - 1))
    local heal=$((25 + level * 5))
    health=$((health + heal))
    (( health > max_health )) && health=$max_health
    printf '%s🧪 Potion used!%s Restored %d HP. HP: %d/%d\n' "$green" "$reset" "$heal" "$health" "$max_health"
}

battle() {
    local names=(
        'Permission Phantom'
        'Root Raider'
        'Sudo Destroyer'
        'Kernel Knight'
        'Terminal Titan'
    )
    local index=$((RANDOM % ${#names[@]}))
    enemy="${names[$index]}"
    enemy_hp=$((35 + round * 7 + index * 10))
    local enemy_max=$enemy_hp
    local defending=0

    printf '\n%s╭────────────────────────────────────────────╮%s\n' "$yellow" "$reset"
    printf '%s│ ROUND %d: %-32s │%s\n' "$yellow" "$round" "$enemy" "$reset"
    printf '%s╰────────────────────────────────────────────╯%s\n' "$yellow" "$reset"
    printf 'Enemy HP: %d | Your HP: %d/%d | Level: %d\n' "$enemy_hp" "$health" "$max_health" "$level"

    while (( enemy_hp > 0 && health > 0 )); do
        defending=0
        printf '\n%s[1]%s Attack   %s[2]%s Defend   %s[3]%s Potion   %s[4]%s Inspect   %s[q]%s Flee\n' \
            "$green" "$reset" "$cyan" "$reset" "$magenta" "$reset" "$yellow" "$reset" "$red" "$reset"
        printf '> '
        IFS= read -r action || return 0

        case "$action" in
            1) attack_enemy ;;
            2) defend ;;
            3) use_potion; continue ;;
            4)
                printf '\n%s%s%s\n' "$magenta" "$enemy" "$reset"
                printf 'Threat level: %d/5 | HP: %d/%d\n' "$((index + 1))" "$enemy_hp" "$enemy_max"
                printf 'This enemy is fictional and cannot affect your real system.\n'
                continue
                ;;
            q|Q|flee)
                printf '%sYou escaped the simulated battle.%s\n' "$yellow" "$reset"
                return 0
                ;;
            *) printf '%sInvalid battle command.%s\n' "$red" "$reset"; continue ;;
        esac

        if (( enemy_hp > 0 )); then
            local hit=$((6 + RANDOM % 10 + index * 2 + round / 3))
            if (( defending )); then
                hit=$(( (hit + 1) / 2 ))
            fi
            health=$((health - hit))
            printf '%s💥 ENEMY ATTACK!%s %s hits for %d simulated damage. HP: %d/%d\n' "$red" "$reset" "$enemy" "$hit" "$health" "$max_health"
        fi
    done

    if (( health <= 0 )); then
        health=0
        printf '\n%s╔══════════════════════════════════════╗%s\n' "$red" "$reset"
        printf '%s║       SYSTEM OVERRUN — GAME OVER     ║%s\n' "$red" "$reset"
        printf '%s╚══════════════════════════════════════╝%s\n' "$red" "$reset"
        printf 'Final score: %d | Level: %d | Victories: %d\n' "$score" "$level" "$wins"
        save_game >/dev/null 2>&1 || true
        return 2
    fi

    local reward_xp=$((35 + round * 8 + index * 5))
    local reward_credits=$((15 + round * 4 + index * 3))
    local reward_score=$((50 + round * 20 + index * 10))
    xp=$((xp + reward_xp))
    coins=$((coins + reward_credits))
    score=$((score + reward_score))
    wins=$((wins + 1))
    round=$((round + 1))
    health=$((health + 8))
    (( health > max_health )) && health=$max_health

    printf '\n%s🏆 %s DEFEATED!%s\n' "$green" "$enemy" "$reset"
    printf '+%d XP  +%d credits  +%d score\n' "$reward_xp" "$reward_credits" "$reward_score"
    level_up_check
    save_game >/dev/null 2>&1 || true
    return 0
}

shop() {
    while true; do
        printf '\n%s=== TERMINAL SHOP ===%s\n' "$yellow" "$reset"
        printf 'Credits: %d\n\n' "$coins"
        printf '[1] Repair  +30 HP             20 credits\n'
        printf '[2] Max HP upgrade             60 credits\n'
        printf '[3] Weapon upgrade             75 credits\n'
        printf '[4] Potion                     25 credits\n'
        printf '[q] Back\n> '
        IFS= read -r choice || return
        case "$choice" in
            1)
                if (( coins >= 20 && health < max_health )); then
                    coins=$((coins - 20)); health=$((health + 30)); (( health > max_health )) && health=$max_health
                    printf '%sRepaired to %d/%d HP.%s\n' "$green" "$health" "$max_health" "$reset"
                else printf 'Not enough credits or HP is already full.\n'; fi ;;
            2)
                if (( coins >= 60 )); then coins=$((coins - 60)); max_health=$((max_health + 20)); health=$max_health; printf 'Max HP upgraded to %d.\n' "$max_health"; else printf 'Not enough credits.\n'; fi ;;
            3)
                if (( coins >= 75 )); then coins=$((coins - 75)); weapon_level=$((weapon_level + 1)); printf 'Weapon upgraded to level %d.\n' "$weapon_level"; else printf 'Not enough credits.\n'; fi ;;
            4)
                if (( coins >= 25 )); then coins=$((coins - 25)); potions=$((potions + 1)); printf 'Potion added. You now have %d.\n' "$potions"; else printf 'Not enough credits.\n'; fi ;;
            q|Q|back|exit) return ;;
            *) printf 'Invalid option.\n' ;;
        esac
    done
}

help_menu() {
    printf '\n%s=== HELP ===%s\n' "$cyan" "$reset"
    printf 'Battle enemies, earn XP, level up, buy upgrades, and save your progress.\n'
    printf 'The game is entirely simulated and never executes destructive commands.\n\n'
    printf 'Save file: %s\n' "$SAVE_FILE"
    printf 'Main menu: Battle, Status, Enemy Database, Shop, Save, Help, Quit.\n'
}

main_menu() {
    while true; do
        print_banner
        printf '\n%sOperator:%s %s  %sLevel:%s %d  %sXP:%s %d/%d\n' "$cyan" "$reset" "$player_name" "$cyan" "$reset" "$level" "$cyan" "$reset" "$xp" "$(xp_needed)"
        printf '%sHP:%s %d/%d  %sCredits:%s %d  %sScore:%s %d\n\n' "$green" "$reset" "$health" "$max_health" "$yellow" "$reset" "$coins" "$magenta" "$reset" "$score"
        printf '%s[1]%s Battle    %s[2]%s Status    %s[3]%s Enemies\n' "$green" "$reset" "$cyan" "$reset" "$magenta" "$reset"
        printf '%s[4]%s Shop      %s[5]%s Save      %s[6]%s Help\n' "$yellow" "$reset" "$green" "$reset" "$cyan" "$reset"
        printf '%s[q]%s Quit\n> ' "$red" "$reset"
        IFS= read -r choice || break
        case "$choice" in
            1) battle; status=$?; (( status == 2 )) && pause_game ;;
            2) show_status; pause_game ;;
            3) show_enemies; pause_game ;;
            4) shop; save_game >/dev/null 2>&1 || true ;;
            5) save_game; pause_game ;;
            6) help_menu; pause_game ;;
            q|Q|quit|exit) save_game >/dev/null 2>&1 || true; printf 'Goodbye, %s!\n' "$player_name"; break ;;
            *) printf '%sInvalid option.%s\n' "$red" "$reset"; sleep 1 ;;
        esac
    done
}

case "${1:-}" in
    --version|-v|version)
        printf 'sudo-destroyers version %s\n' "$VERSION"
        exit 0
        ;;
    --help|-h|help)
        help_menu
        exit 0
        ;;
    --new)
        new_game
        save_game
        main_menu
        ;;
    --delete-save)
        rm -f "$SAVE_FILE"
        printf 'Save deleted: %s\n' "$SAVE_FILE"
        exit 0
        ;;
esac

if load_game; then
    printf '%sLoaded save for %s (level %d).%s\n' "$green" "$player_name" "$level" "$reset"
    sleep 1
else
    new_game
    save_game >/dev/null 2>&1 || true
fi

main_menu
