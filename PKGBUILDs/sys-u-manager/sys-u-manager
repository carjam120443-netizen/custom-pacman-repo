#!/usr/bin/env bash

VERSION='1.0'

usage() {
    cat <<'EOF'
Usage: sys-u-manager <command>

System update manager for Pacman/MSYS2.

Commands:
  check       Check for available package updates
  update      Refresh package databases
  upgrade     Upgrade the complete system
  full        Refresh databases and perform a full upgrade
  list        List installed packages
  orphans     Find unneeded dependency packages
  clean       Clean Pacman's package cache
  menu        Open the interactive update manager
  help        Show this help
  version     Show version

Examples:
  sys-u-manager check
  sys-u-manager full
  sys-u-manager orphans
EOF
}

pause() {
    read -r -p 'Press Enter to continue...' _
}

menu() {
    while true; do
        clear 2>/dev/null || true
        printf '\033[1;36m'
        cat <<'EOF'
  ╔════════════════════════════════════╗
  ║          sys-u-manager             ║
  ╠════════════════════════════════════╣
  ║  1) Check for updates              ║
  ║  2) Refresh package databases      ║
  ║  3) Upgrade system                 ║
  ║  4) Full system update             ║
  ║  5) List installed packages        ║
  ║  6) Find orphaned dependencies     ║
  ║  7) Clean package cache            ║
  ║  0) Exit                            ║
  ╚════════════════════════════════════╝
EOF
        printf '\033[0m'
        read -r -p 'Select an option: ' choice
        case "$choice" in
            1) pacman -Qu; pause ;;
            2) pacman -Sy; pause ;;
            3) pacman -Su; pause ;;
            4) pacman -Syu; pause ;;
            5) pacman -Q; pause ;;
            6) pacman -Qdt; pause ;;
            7) pacman -Sc; pause ;;
            0) return 0 ;;
            *) echo 'Invalid option.'; pause ;;
        esac
    done
}

case "${1:-menu}" in
    check) pacman -Qu ;;
    update|sync|refresh) pacman -Sy ;;
    upgrade|up) pacman -Su ;;
    full|update-system) pacman -Syu ;;
    list|ls) pacman -Q ;;
    orphans) pacman -Qdt ;;
    clean) pacman -Sc ;;
    menu) menu ;;
    version|--version|-v) printf 'sys-u-manager version %s\n' "$VERSION" ;;
    help|--help|-h) usage ;;
    *) echo "sys-u-manager: unknown command: $1" >&2; echo; usage; exit 1 ;;
esac
