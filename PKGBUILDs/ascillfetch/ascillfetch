#!/usr/bin/env bash

VERSION='1.1'

usage() {
    cat <<'EOF'
Usage: ascillfetch [command] [name]

Commands:
  list                 List all built-in systems
  show NAME            Show ASCII art for a system
  random               Show a random system
  categories           List artwork categories
  about                About ascillfetch
  --version, -v        Show version
  --help, -h           Show this help
EOF
}

