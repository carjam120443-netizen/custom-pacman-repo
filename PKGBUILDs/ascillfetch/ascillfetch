#!/usr/bin/env bash
VERSION='1.2'

usage() {
    cat <<'EOF'
Usage: ascillfetch [command] [name]
  list       List all systems
  show NAME  Show ASCII art for a system
  random     Show random art
  categories List categories
  about      About ascillfetch
  -v         Show version
  -h         Show help
EOF
}

art() {
    local n="$1"
    case "$n" in
        freebsd) printf '%s\n' '      /\_/\\' '     ( o.o )' '      > ^ <' '     /|   |\\' '    /_|___|_\\' 'FreeBSD' ;;
        openbsd) printf '%s\n' '     .-""-.' '    / .--. \' '   / /    \\ \' '   | | () | |' '   \\ \__/ /' '    `-.__.-`' 'OpenBSD' ;;
        netbsd) printf '%s\n' '      __' '   __(  )__' '  /  /||\  \' ' /__/ || \__\' '     /__\' 'NetBSD' ;;
        dragonfly) printf '%s\n' '       /\' '      /  \' '  ___/ /\ \' ' / _  /  \\ \' '/____/    \_\' 'DragonFly BSD' ;;
        ghostbsd) printf '%s\n' '      .---.' '     / .-. \' '    | |o_o| |' '    | |:_/| |' '   //   \\ \' '  (|     | )' 'GhostBSD' ;;
        midnightbsd) printf '%s\n' '      .----.' '     / .--. \' '    | |    | |' '    | |____| |' '     \____/' 'MidnightBSD' ;;
        trueos) printf '%s\n' '    _______' '   / _____ \' '  / /     \' ' | |  T  | |' '  \ \___/ /' '   \_____/' 'TrueOS' ;;
        linux) printf '%s\n' '       .-.' '      (   )' '       | |' '     __| |__' '    /       \' '   /  Linux  \' '  /___________\\' 'Linux' ;;
        ubuntu) printf '%s\n' '      .----.' '   .-(  o  o  )-.' '  (      +      )' '   `-(       )-`' '      `-----`' 'Ubuntu' ;;
        debian) printf '%s\n' '       __' '     _/  \_' '    /  /\  \' '   |  /  \  |' '   | / () \ |' '    \  /\  /' '     \____/' 'Debian' ;;
        fedora) printf '%s\n' '       .-~~-.' '     .-      -.' '    /   .--.   \' '   |   (    )   |' '    \   `--`  /' '     `-.____.-`' 'Fedora' ;;
        arch) printf '%s\n' '        /\' '       /  \' '      / /\ \' '     / /  \' '    / /____\' '   /________\' '      ARCH' 'Arch Linux' ;;
        manjaro) printf '%s\n' '      |\  /|' '      | \/ |' '      |  /  |' '   ___| /   |___' '  /___|/____|___\' '      MANJARO' 'Manjaro' ;;
        opensuse) printf '%s\n' '       ______' '     /        \' '    /  .----.  \' '   |  (  ()  )  |' '    \  `----`  /' '     `--------`' 'openSUSE' ;;
        gentoo) printf '%s\n' '       .-.' '      (o o)' '      | O \' '       \   \' '        `~~~`' 'Gentoo' ;;
        slackware) printf '%s\n' '      ______' '     / ____/\' '    / /___ / /' '   /_____/ / \' '  /______/   \' '    SLACK' 'Slackware' ;;
        alpine) printf '%s\n' '       /\' '      /  \' '     / /\ \' '    / /  \' '   /_/____\' '     ALPINE' 'Alpine Linux' ;;
        void) printf '%s\n' '      \\   \\' '       \\   \\' '   _____\_\_____' '  /      / \' ' /______/   \' '     VOID' 'Void Linux' ;;
        nixos) printf '%s\n' '      /\_/\' '     ( o   o )' '      \_=_/' '     /     \' '    / NIXOS \' '   /_________\' 'NixOS' ;;
        linuxmint) printf '%s\n' '      _______' '     /       \' '    |  MINT   |' '    |   ___   |' '     \_/   \_/' '      `-----`' 'Linux Mint' ;;
        popos) printf '%s\n' '      ______' '     /      \' '    |  POP!  |' '    |   OS   |' '     \______/' 'Pop!_OS' ;;
        kali) printf '%s\n' '       /\' '      /  \' '     / /\ \' '    / /__\ \' '   /_/    \_\' '     KALI' 'Kali Linux' ;;
        elementary) printf '%s\n' '      .------.' '     /  .--.  \' '    |  /    \  |' '    | |  ()  | |' '     \  \__/ /' '      `------`' 'elementary OS' ;;
        zorin) printf '%s\n' '       ____' '      / __ \' '     / /  \' '    | | () | |' '     \ \__/ /' '      `----`' 'Zorin OS' ;;
        android) printf '%s\n' '      .-""-.' '     /  o  o  \' '    |    ^    |' '    |  \___/  |' '     `--.___.--`' '       Android' ;;
        postmarketos) printf '%s\n' '      .------.' '     /  .--.  \' '    |  |    |  |' '    |  | () |  |' '     \  `--`  /' '      `------`' 'postmarketOS' ;;
        grapheneos) printf '%s\n' '       ______' '      /      \' '     |  G O   |' '     |   S    |' '      \______/' 'GrapheneOS' ;;
        lineageos) printf '%s\n' '      .------.' '     /  /\   \' '    |  /  \   |' '    | | () |   |' '     \_\__/__/' 'LineageOS' ;;
        sailfish) printf '%s\n' '       __/\' '      /    \' '     /  /\  \' '    |  /  \  |' '     \_/  \_/' 'Sailfish OS' ;;
        windows) printf '%s\n' '       ______  ______' '      |      ||      |' '      |      ||      |' '      |______||______|' '      |      ||      |' '      |______||______|' 'Windows' ;;
        windows95) printf '%s\n' '       ________' '      /  ______  \' '     |  |  __  |  |' '     |  | |  | |  |' '     |  |_|__|_|  |' '      \________/' 'Windows 95' ;;
        windows98) printf '%s\n' '       .------.' '      /  .--.  \' '     |  |    |  |' '     |  |____|  |' '      \________/' 'Windows 98' ;;
        windowsxp) printf '%s\n' '       ______' '      |  _  _ |' '      | | || ||' '      | |_||_||' '      |  XP   |' 'Windows XP' ;;
        windowsvista) printf '%s\n' '       .----.' '      /  .--.  \' '     |  | () |  |' '     |  |____|  |' '      \__\__/' 'Windows Vista' ;;
        windows7) printf '%s\n' '      .------.' '     | 7    / |' '     |    /   |' '     |   /    |' '     `--------`' 'Windows 7' ;;
        windows8) printf '%s\n' '      ________' '     |  |  |  |' '     |  |  |  |' '     |  |__|  |' '     |________|' 'Windows 8' ;;
        windows10) printf '%s\n' '      ________' '     |  |  |  |' '     |  |  |  |' '     |  |  |  |' '     |__|__|__|' 'Windows 10' ;;
        windows11) printf '%s\n' '      ________' '     |  |  |  |' '     |  |  |  |' '     |  |  |  |' '     |__|__|__|' 'Windows 11' ;;
        msdos) printf '%s\n' '     +----------------+' '     | C:\\> _         |' '     |                |' '     | MS-DOS         |' '     +----------------+' 'MS-DOS' ;;
        macos) printf '%s\n' '       .-""-.' '      /  .--.  \' '     |  |    |  |' '     |  | () |  |' '      \  `--` /' '       `-.__.-`' 'macOS' ;;
        ios) printf '%s\n' '      .------.' '     /  .----.  \' '    |  | iOS |  |' '    |  |     |  |' '     \  `---`  /' '      `------`' 'iOS' ;;
        classicmac) printf '%s\n' '      .------.' '     /  _____  \' '    |  |     |  |' '    |  |_____|  |' '     \________/' 'Classic Mac OS' ;;
        unix) printf '%s\n' '       ______' '      / ____ \' '     / /    \' '    | | UNIX | |' '     \ \____/ /' '      `------`' 'UNIX' ;;
        solaris) printf '%s\n' '       .----.' '      / .--. \' '     | |    | |' '     | |____| |' '      \_____/ \' '       Solaris' ;;
        illumos) printf '%s\n' '      .-~~-.' '     /  /\  \' '    |  /  \  |' '    | /____\ |' '     `-illumos-`' 'illumos' ;;
        aix) printf '%s\n' '      ______' '     /  __  \' '    |  /  \  |' '    | | AIX | |' '     \ \__/ /' '      `------`' 'AIX' ;;
        hpux) printf '%s\n' '      ______' '     |  HP   |' '     |  UX   |' '     | UNIX  |' '     `-------`' 'HP-UX' ;;
        irix) printf '%s\n' '      .----.' '     / IRIX \' '    |  UNIX  |' '     \      /' '      `----`' 'IRIX' ;;
        plan9) printf '%s\n' '       /\_/\' '      ( o   o )' '       \_=_/' '      /| 9 |\' '     /_|___|_\' 'Plan 9' ;;
        haiku) printf '%s\n' '       /\' '      /  \' '     |  ()  |' '     | Haiku |' '      \____/' 'Haiku OS' ;;
        *) return 1 ;;
    esac
}

names=(freebsd openbsd netbsd dragonfly ghostbsd midnightbsd trueos linux ubuntu debian fedora arch manjaro opensuse gentoo slackware alpine void nixos linuxmint popos kali elementary zorin android postmarketos grapheneos lineageos sailfish windows windows95 windows98 windowsxp windowsvista windows7 windows8 windows10 windows11 msdos macos ios classicmac unix solaris illumos aix hpux irix plan9 haiku)

case "${1:-random}" in
    list) printf '%s\n' "${names[@]}" | sort ;;
    show) [[ -n "$2" ]] && art "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" || { echo 'Usage: ascillfetch show NAME'; exit 1; } ;;
    random) art "${names[RANDOM % ${#names[@]}]}" ;;
    categories) printf '%s\n' 'BSD' 'Linux' 'Mobile' 'Windows' 'Apple' 'Unix/Other' ;;
    about) printf 'ascillfetch v%s - %d built-in entries.\n' "$VERSION" "${#names[@]}" ;;
    --version|-v|version) printf 'ascillfetch version %s\n' "$VERSION" ;;
    --help|-h|help) usage ;;
    *) art "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" || { echo "Unknown system: $1" >&2; usage; exit 1; } ;;
esac
