names=(freebsd openbsd netbsd dragonfly ghostbsd midnightbsd trueos linux ubuntu debian fedora arch manjaro opensuse gentoo slackware alpine void nixos linuxmint popos kali elementary zorin android postmarketos ubuntutouch grapheneos lineageos sailfish windows windows95 windows98 windowsxp windowsvista windows7 windows8 windows10 windows11 msdos macos ios classicmac unix solaris illumos aix hpux irix plan9 haiku)

list_names() { printf '%s\n' "${names[@]}" | sort; }

case "${1:-random}" in
    list) list_names ;;
    show) [[ -n "$2" ]] && art "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" || { echo 'Usage: ascillfetch show NAME'; exit 1; } ;;
    random) art "${names[RANDOM % ${#names[@]}]}" ;;
    categories)
        printf '%s\n' 'BSD: FreeBSD OpenBSD NetBSD DragonFly BSD GhostBSD MidnightBSD TrueOS' 'Linux: Linux Ubuntu Debian Fedora Arch Manjaro openSUSE Gentoo Slackware Alpine Void NixOS Linux Mint Pop!_OS Kali elementary Zorin' 'Mobile: Android postmarketOS Ubuntu Touch GrapheneOS LineageOS Sailfish OS' 'Windows: Windows 95/98/XP/Vista/7/8/10/11, MS-DOS' 'Apple: macOS iOS Classic Mac OS' 'Unix/Other: UNIX Solaris illumos AIX HP-UX IRIX Plan 9 Haiku' ;;
    about) printf 'ascillfetch v%s\nA built-in operating-system ASCII art gallery for the terminal.\nIncludes %d prebuilt entries.\n' "$VERSION" "${#names[@]}" ;;
    --version|-v|version) printf 'ascillfetch version %s\n' "$VERSION" ;;
    --help|-h|help) usage ;;
    *) art "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" || { echo "Unknown system: $1" >&2; usage; exit 1; } ;;
esac
