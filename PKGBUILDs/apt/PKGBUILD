pkgname=apt
pkgver=1.0
pkgrel=3
pkgdesc="Debian-style APT frontend for Pacman on MSYS2"
arch=('any')
license=('MIT')
depends=('bash' 'pacman')
source=()
sha256sums=()

package() {
    install -d "$pkgdir/usr/bin"

    cat > "$pkgdir/usr/bin/apt" <<'EOF'
#!/usr/bin/env bash

VERSION='1.0'

usage() {
    cat <<'HELP'
Usage: apt <command> [packages...]

APT-style frontend for Pacman/MSYS2.

Commands:
  install, i PACKAGE...  Install packages
  remove, r PACKAGE...   Remove packages
  update                 Refresh package databases
  upgrade                Upgrade installed packages
  full-upgrade           Refresh databases and fully upgrade
  search, s QUERY        Search available packages
  show, info PACKAGE     Show package information
  list                   List installed packages
  clean                  Clean Pacman's package cache
  autoremove             Remove orphaned dependency packages
  help                   Show this help
  version                Show version
HELP
}

need_args() {
    if (( $# == 0 )); then
        echo "apt: no packages specified" >&2
        return 1
    fi
}

case "${1:-help}" in
    install|i)
        shift; need_args "$@" && pacman -S --needed "$@" ;;
    remove|r|uninstall)
        shift; need_args "$@" && pacman -R "$@" ;;
    update|sync|refresh)
        pacman -Sy ;;
    upgrade|up)
        pacman -Su ;;
    full-upgrade|dist-upgrade)
        pacman -Syu ;;
    search|s)
        shift; need_args "$@" && pacman -Ss "$@" ;;
    show|info)
        shift; need_args "$@" && pacman -Si "$@" ;;
    list|ls)
        pacman -Q ;;
    clean)
        pacman -Sc ;;
    autoremove)
        orphans=$(pacman -Qdtq 2>/dev/null || true)
        if [[ -n "$orphans" ]]; then
            pacman -Rns $orphans
        else
            echo 'No orphaned packages found.'
        fi
        ;;
    version|--version|-v)
        printf 'apt (Pacman frontend) version %s\n' "$VERSION" ;;
    help|--help|-h)
        usage ;;
    *)
        echo "apt: unknown command: $1" >&2
        echo
        usage
        exit 1
        ;;
esac
EOF

    chmod 755 "$pkgdir/usr/bin/apt"
}
