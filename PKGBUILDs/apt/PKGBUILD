pkgname=apt
pkgver=1.1
pkgrel=1
pkgdesc="Debian-style APT frontend with real Debian repository metadata for MSYS2"
arch=('any')
license=('MIT')
depends=('bash' 'pacman' 'curl' 'xz')
source=()
sha256sums=()

package() {
    install -d "$pkgdir/usr/bin"

    cat > "$pkgdir/usr/bin/apt" <<'EOF'
#!/usr/bin/env bash

VERSION='1.1'
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/apt"
CONFIG_FILE="$CONFIG_DIR/sources.list"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/apt"
INDEX_FILE="$CACHE_DIR/Packages"

DEFAULT_MIRROR='https://deb.debian.org/debian'
DEFAULT_SUITE='trixie'
DEFAULT_COMPONENT='main'

usage() {
    cat <<'HELP'
Usage: apt <command> [packages...]

APT-style frontend for MSYS2 with real Debian repository metadata.

MSYS2 packages are still installed by Pacman. Debian commands below
use the real Debian archive for searching, showing, and downloading
Debian .deb packages.

MSYS2 commands:
  install, i PACKAGE...  Install an MSYS2 package with Pacman
  remove, r PACKAGE...   Remove an MSYS2 package
  update                 Refresh Pacman databases
  upgrade                Upgrade MSYS2 packages
  full-upgrade           Full MSYS2 upgrade
  list                   List installed MSYS2 packages
  clean                  Clean Pacman cache
  autoremove             Remove orphaned MSYS2 dependencies

Debian repository commands:
  deb-update             Download Debian Packages metadata
  deb-search, ds QUERY   Search the real Debian repository
  deb-show, di PACKAGE   Show Debian package metadata
  deb-download PACKAGE   Download a real Debian .deb file
  sources                Show configured Debian source
  sources-set [URI] [SUITE] [COMPONENT]
                         Configure a Debian repository

Other:
  search, s QUERY        Search MSYS2/Pacman packages
  show, info PACKAGE     Show MSYS2 package information
  help                   Show this help
  version                Show version

Default Debian repository:
  https://deb.debian.org/debian trixie main

NOTE: Debian .deb files are not installed into MSYS2. They are downloaded
for inspection/use in a Debian environment; MSYS2 packages remain Pacman
packages.
HELP
}

need_args() {
    if (( $# == 0 )); then
        echo "apt: no arguments specified" >&2
        return 1
    fi
}

load_sources() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        . "$CONFIG_FILE"
    fi
    DEBIAN_MIRROR="${DEBIAN_MIRROR:-$DEFAULT_MIRROR}"
    DEBIAN_SUITE="${DEBIAN_SUITE:-$DEFAULT_SUITE}"
    DEBIAN_COMPONENT="${DEBIAN_COMPONENT:-$DEFAULT_COMPONENT}"
}

save_sources() {
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<CFG
DEBIAN_MIRROR='$DEBIAN_MIRROR'
DEBIAN_SUITE='$DEBIAN_SUITE'
DEBIAN_COMPONENT='$DEBIAN_COMPONENT'
CFG
}

deb_update() {
    load_sources
    mkdir -p "$CACHE_DIR"
    local url="${DEBIAN_MIRROR%/}/dists/${DEBIAN_SUITE}/${DEBIAN_COMPONENT}/binary-amd64/Packages.xz"
    echo "==> Downloading real Debian repository metadata"
    echo "    $url"
    curl -fL --retry 3 --silent --show-error "$url" | xz -dc > "$INDEX_FILE"
    printf 'Debian repository metadata updated: %s\n' "$INDEX_FILE"
}

ensure_index() {
    if [[ ! -s "$INDEX_FILE" ]]; then
        deb_update || return 1
    fi
}

deb_search() {
    need_args "$@" || return
    ensure_index || return
    local query
    query="$*"
    awk -v q="$query" 'BEGIN{IGNORECASE=1} /^Package: / {p=$0} /^Description: / {d=$0} /^Description-md5:/ {if (p ~ q || d ~ q) {print p; print d; print ""}}' "$INDEX_FILE" | head -n 120
}

deb_show() {
    need_args "$@" || return
    ensure_index || return
    local wanted="$1"
    awk -v wanted="$wanted" '
        BEGIN { RS=""; FS="\n" }
        $0 ~ "(^|\n)Package: " wanted "(\n|$)" { print; found=1; exit }
        END { if (!found) exit 1 }
    ' "$INDEX_FILE" || echo "apt: Debian package not found: $wanted" >&2
}

deb_download() {
    need_args "$@" || return
    ensure_index || return
    load_sources
    local wanted="$1"
    local filename
    filename="$(awk -v wanted="$wanted" '
        BEGIN { RS=""; FS="\n" }
        $0 ~ "(^|\n)Package: " wanted "(\n|$)" {
            for (i=1; i<=NF; i++) if ($i ~ /^Filename: /) { sub(/^Filename: /, "", $i); print $i; exit }
        }
    ' "$INDEX_FILE")"
    if [[ -z "$filename" ]]; then
        echo "apt: Debian package not found: $wanted" >&2
        return 1
    fi
    mkdir -p "$HOME/Downloads/apt-debs"
    local url="${DEBIAN_MIRROR%/}/$filename"
    local output="$HOME/Downloads/apt-debs/$(basename "$filename")"
    echo "==> Downloading real Debian package"
    echo "    $url"
    curl -fL --retry 3 --show-error "$url" -o "$output"
    echo "Downloaded: $output"
}

show_sources() {
    load_sources
    printf 'Debian source:\n  %s %s %s\n' "$DEBIAN_MIRROR" "$DEBIAN_SUITE" "$DEBIAN_COMPONENT"
    printf 'Metadata cache:\n  %s\n' "$INDEX_FILE"
}

set_sources() {
    DEBIAN_MIRROR="${1:-$DEFAULT_MIRROR}"
    DEBIAN_SUITE="${2:-$DEFAULT_SUITE}"
    DEBIAN_COMPONENT="${3:-$DEFAULT_COMPONENT}"
    save_sources
    show_sources
}

case "${1:-help}" in
    install|i)
        shift; need_args "$@" && pacman -S --needed "$@" ;;
    remove|r|uninstall)
        shift; need_args "$@" && pacman -R "$@" ;;
    update|sync|refresh)
        pacman -Sy ;;
    upgrade|up)
        pacman -Su ;;
    full-upgrade|dist-upgrade)
        pacman -Syu ;;
    search|s)
        shift; need_args "$@" && pacman -Ss "$@" ;;
    show|info)
        shift; need_args "$@" && pacman -Si "$@" ;;
    list|ls)
        pacman -Q ;;
    clean)
        pacman -Sc ;;
    autoremove)
        orphans=$(pacman -Qdtq 2>/dev/null || true)
        if [[ -n "$orphans" ]]; then
            pacman -Rns $orphans
        else
            echo 'No orphaned MSYS2 dependency packages found.'
        fi
        ;;
    deb-update)
        deb_update ;;
    deb-search|ds)
        shift; deb_search "$@" ;;
    deb-show|di)
        shift; deb_show "$@" ;;
    deb-download)
        shift; deb_download "$@" ;;
    sources)
        show_sources ;;
    sources-set)
        shift; set_sources "$@" ;;
    version|--version|-v)
        printf 'apt (Debian repository + Pacman frontend) version %s\n' "$VERSION" ;;
    help|--help|-h)
        usage ;;
    *)
        echo "apt: unknown command: $1" >&2
        echo
        usage
        exit 1
        ;;
esac
EOF

    chmod 755 "$pkgdir/usr/bin/apt"
}
