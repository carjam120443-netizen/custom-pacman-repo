#!/usr/bin/env bash

VERSION='1.0'

usage() {
    cat <<'EOF'
Usage: git-gui <command> [options]

A lightweight terminal-based GUI-style frontend for Git.

Commands:
  status        Show repository status
  log           Show recent commits
  branches      List branches
  diff          Show working-tree changes
  add FILE...   Stage files
  commit        Commit staged changes
  pull          Pull from the configured remote
  push          Push to the configured remote
  clone URL DIR Clone a repository
  menu          Open interactive Git menu
  help          Show this help
  version       Show version

The interactive menu provides quick access to common Git operations.
EOF
}

pause() {
    read -r -p 'Press Enter to continue...' _
}

menu() {
    while true; do
        clear 2>/dev/null || true
        printf '\033[1;36m'
        cat <<'EOF'
  ╔══════════════════════════════════╗
  ║             git-gui              ║
  ╠══════════════════════════════════╣
  ║  1) Status                       ║
  ║  2) Log                          ║
  ║  3) Branches                     ║
  ║  4) Diff                         ║
  ║  5) Stage files                  ║
  ║  6) Commit                       ║
  ║  7) Pull                         ║
  ║  8) Push                         ║
  ║  9) Git info                     ║
  ║  0) Exit                         ║
  ╚══════════════════════════════════╝
EOF
    printf '\033[0m'
        read -r -p 'Select an option: ' choice
        case "$choice" in
            1) git status; pause ;;
            2) git log --oneline --decorate -10; pause ;;
            3) git branch -a; pause ;;
            4) git diff; pause ;;
            5)
                read -r -p 'Files (or .): ' files
                git add $files
                pause
                ;;
            6)
                read -r -p 'Commit message: ' msg
                git commit -m "$msg"
                pause
                ;;
            7) git pull; pause ;;
            8) git push; pause ;;
            9) git remote -v; printf '\n'; git branch --show-current; pause ;;
            0) return 0 ;;
            *) echo 'Invalid option.'; pause ;;
        esac
    done
}

case "${1:-menu}" in
    status) git status ;;
    log) git log --oneline --decorate -10 ;;
    branches) git branch -a ;;
    diff) git diff ;;
    add)
        shift
        if (( $# == 0 )); then echo 'git-gui: no files specified' >&2; exit 1; fi
        git add "$@"
        ;;
    commit)
        shift
        if (( $# == 0 )); then echo 'git-gui: use git-gui commit "message"' >&2; exit 1; fi
        git commit -m "$*"
        ;;
    pull) git pull ;;
    push) git push ;;
    clone)
        if (( $# != 3 )); then echo 'Usage: git-gui clone URL DIRECTORY' >&2; exit 1; fi
        git clone "$2" "$3"
        ;;
    menu) menu ;;
    version|--version|-v) printf 'git-gui version %s\n' "$VERSION" ;;
    help|--help|-h) usage ;;
    *) echo "git-gui: unknown command: $1" >&2; usage; exit 1 ;;
esac
