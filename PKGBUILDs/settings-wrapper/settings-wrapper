#!/usr/bin/env bash

# settings-wrapper - simple settings launcher for MSYS2

VERSION='1.0'

if [[ -f /etc/settings-wrapper.conf ]]; then
    # shellcheck disable=SC1091
    source /etc/settings-wrapper.conf
fi
if [[ -f "$HOME/.settings-wrapper.conf" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.settings-wrapper.conf"
fi

printf '\033[1;36msettings-wrapper\033[0m v%s\n' "$VERSION"
printf 'Launching MSYS2 settings/configuration tools...\n\n'

case "${1:-}" in
    --version|-v|version)
        printf 'settings-wrapper version %s\n' "$VERSION"
        exit 0
        ;;
    --help|-h|help)
        printf '%s\n' \
            'settings-wrapper - a simple MSYS2 settings launcher' \
            '' \
            'Usage: settings-wrapper [command]' \
            '' \
            'Commands:' \
            '  about       Show information' \
            '  shell       Open a settings shell' \
            '  config      Show the config file location' \
            '  version     Show the version' \
            '  help        Show this help' \
            '' \
            'With no command, an interactive settings menu is shown.'
        exit 0
        ;;
    about)
        printf 'settings-wrapper v%s\n' "$VERSION"
        printf 'A lightweight settings wrapper for MSYS2.\n'
        printf 'Config: /etc/settings-wrapper.conf or ~/.settings-wrapper.conf\n'
        exit 0
        ;;
    config)
        printf 'System config: /etc/settings-wrapper.conf\n'
        printf 'User config:   %s/.settings-wrapper.conf\n' "$HOME"
        exit 0
        ;;
    shell)
        exec bash
        ;;
esac

while true; do
    printf '\n\033[1;33mSettings Wrapper\033[0m\n'
    printf '1) Package manager settings\n'
    printf '2) Shell environment\n'
    printf '3) View configuration\n'
    printf '4) Open shell\n'
    printf '5) Exit\n'
    printf 'Select an option: '
    IFS= read -r choice || break

    case "$choice" in
        1)
            printf '\nCurrent package manager: pacman\n'
            printf 'Run "pkg help" for the pkg frontend commands.\n'
            ;;
        2)
            printf '\nShell: %s\n' "${SHELL:-bash}"
            printf 'MSYSTEM: %s\n' "${MSYSTEM:-unknown}"
            printf 'PATH: %s\n' "$PATH"
            ;;
        3)
            if [[ -f /etc/settings-wrapper.conf ]]; then
                printf '\n--- /etc/settings-wrapper.conf ---\n'
                cat /etc/settings-wrapper.conf
            else
                printf '\nNo system configuration file found.\n'
            fi
            ;;
        4)
            bash
            ;;
        5|q|quit|exit)
            break
            ;;
        *)
            printf 'settings-wrapper: invalid option\n'
            ;;
    esac
done
