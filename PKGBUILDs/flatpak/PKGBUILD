pkgname=flatpak
pkgver=1.5
pkgrel=1
pkgdesc="Flatpak-style application manager with configurable remotes and real Flathub integration for MSYS2"
arch=('any')
license=('MIT')
depends=('bash' 'curl')
source=()
sha256sums=()

package() {
    install -d "$pkgdir/usr/bin"

    cat > "$pkgdir/usr/bin/flatpak" <<'EOF'
#!/usr/bin/env bash
set -e

VERSION='1.5'
FLATHUB_API='https://flathub.org/api/v2'
FLATHUB_REPO='https://dl.flathub.org/repo/flathub.flatpakrepo'
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/flatpak"
REMOTES_FILE="$CONFIG_DIR/remotes"
INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak-apps"

usage() {
    cat <<'HELP'
Usage: flatpak <command> [arguments...]

Flatpak/remote frontend for MSYS2.

Commands:
  remote-add NAME URL      Add a custom Flatpak remote
  remote-add flathub       Add the real Flathub remote
  remote-delete NAME       Remove a configured remote
  remote-list              List configured remotes
  remotes                  Alias for remote-list
  search QUERY             Search real Flathub applications
  info APP                 Show real Flathub application information
  install APP              Download a Flathub .flatpakref
  uninstall APP            Remove a locally downloaded Flatpak reference
  list                     List locally downloaded Flatpaks
  update                   Check configured remote metadata
  run APP                  Show how to run the downloaded Flatpak
  version                  Show version
  help                     Show this help

Remote examples:
  flatpak remote-add flathub
  flatpak remote-add myrepo https://example.com/repo/myrepo.flatpakrepo
  flatpak remote-delete myrepo
  flatpak remotes
HELP
}

remote_add() {
    if (( $# != 2 )); then
        echo 'Usage: flatpak remote-add NAME URL' >&2
        return 1
    fi
    local name="$1" url="$2"
    if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "flatpak: invalid remote name: $name" >&2
        return 1
    fi
    if [[ ! "$url" =~ ^https?:// ]]; then
        echo 'flatpak: remote URL must start with http:// or https://' >&2
        return 1
    fi
    mkdir -p "$CONFIG_DIR"
    touch "$REMOTES_FILE"
    grep -v -E "^${name}[[:space:]]" "$REMOTES_FILE" > "$REMOTES_FILE.tmp" || true
    printf '%s\t%s\n' "$name" "$url" >> "$REMOTES_FILE.tmp"
    mv "$REMOTES_FILE.tmp" "$REMOTES_FILE"
    echo "Remote added: $name -> $url"
}

add_flathub() {
    remote_add flathub "$FLATHUB_REPO"
}

remote_delete() {
    if (( $# != 1 )); then
        echo 'Usage: flatpak remote-delete NAME' >&2
        return 1
    fi
    local name="$1"
    if [[ ! -f "$REMOTES_FILE" ]] || ! grep -q -E "^${name}[[:space:]]" "$REMOTES_FILE"; then
        echo "flatpak: remote not found: $name" >&2
        return 1
    fi
    grep -v -E "^${name}[[:space:]]" "$REMOTES_FILE" > "$REMOTES_FILE.tmp" || true
    mv "$REMOTES_FILE.tmp" "$REMOTES_FILE"
    echo "Remote removed: $name"
}

remote_list() {
    if [[ ! -s "$REMOTES_FILE" ]]; then
        echo 'No Flatpak remotes configured.'
        return 0
    fi
    printf '%-4s %-28s %s\n' '#' 'NAME' 'URL'
    printf '%-4s %-28s %s\n' '----' '----------------------------' '---'
    local n=0 name url
    while IFS=$'\t' read -r name url; do
        [[ -n "$name" ]] || continue
        ((++n))
        printf '%-4s %-28s %s\n' "$n" "$name" "$url"
    done < "$REMOTES_FILE"
}

search_apps() {
    if (( $# == 0 )); then
        echo 'flatpak: search query required' >&2
        return 1
    fi
    local query="$*"
    local payload
    payload="$(printf '%s' "$query" | awk 'BEGIN { printf "{\"query\":\"" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s", $0 } END { printf "\",\"filters\":[]}" }')"

    echo
    printf 'Flathub search: %s\n' "$query"
    echo '────────────────────────────────────────────────────────────'

    local json
    json="$(curl -fsSL -X POST "$FLATHUB_API/search" \
        -H 'Content-Type: application/json' \
        --data "$payload")"

    local count=0 name app_id summary
    while IFS=$'\t' read -r name app_id summary; do
        [[ -n "$name" ]] || continue
        ((++count))
        printf '\n[%d] %s\n' "$count" "$name"
        printf '    ID: %s\n' "${app_id:-unknown}"
        printf '    %s\n' "${summary:-No description available.}"
    done < <(
        printf '%s' "$json" |
        tr '{' '\n' |
        grep -E '"(name|app_id|id|summary)"[[:space:]]*:' |
        awk '
        function unescape(s) {
            gsub(/\\"/, "\"", s)
            gsub(/\\\\/, "\\", s)
            return s
        }
        /"name"[[:space:]]*:/ {
            if (name != "") print unescape(name) "\t" unescape(app_id) "\t" unescape(summary)
            name=app_id=summary=""
            if (match($0, /"name"[[:space:]]*:[[:space:]]*"([^"]*)"/, m)) name=m[1]
            if (match($0, /"app_id"[[:space:]]*:[[:space:]]*"([^"]*)"/, m)) app_id=m[1]
            if (app_id == "" && match($0, /"id"[[:space:]]*:[[:space:]]*"([^"]*)"/, m)) app_id=m[1]
            if (match($0, /"summary"[[:space:]]*:[[:space:]]*"([^"]*)"/, m)) summary=m[1]
        }
        END { if (name != "") print unescape(name) "\t" unescape(app_id) "\t" unescape(summary) }
        '
    )

    if (( count == 0 )); then
        echo 'No applications found.'
    else
        echo
        echo "Found $count application(s)."
    fi
}

info_app() {
    if (( $# == 0 )); then
        echo 'flatpak: application ID required' >&2
        return 1
    fi
    echo "==> Looking up $1 on real Flathub"
    curl -fsSL "$FLATHUB_API/appstream/$1"
}

install_app() {
    if (( $# == 0 )); then
        echo 'flatpak: application ID required' >&2
        return 1
    fi
    mkdir -p "$INSTALL_DIR"
    local app="$1" output="$INSTALL_DIR/${1//\//_}.flatpakref"
    local ref_url="https://flathub.org/repo/appstream/${app}.flatpakref"
    echo "==> Looking up $app on real Flathub"
    if ! curl -fsSI --max-time 20 "$ref_url" >/dev/null 2>&1; then
        echo "flatpak: Flathub reference not found: $app" >&2
        echo "Try: flatpak search $app" >&2
        return 1
    fi
    echo "==> Downloading: $ref_url"
    curl -fL --retry 3 --show-error "$ref_url" -o "$output"
    echo "Downloaded: $output"
    echo "Note: this MSYS2 frontend downloads the official .flatpakref; a native Flatpak runtime is still required to install/run the application."
}

uninstall_app() {
    if (( $# == 0 )); then
        echo 'flatpak: application ID required' >&2
        return 1
    fi
    local file="$INSTALL_DIR/${1//\//_}.flatpakref"
    if [[ -f "$file" ]]; then
        rm -f "$file"
        echo "Removed: $file"
    else
        echo "flatpak: not installed locally: $1" >&2
        return 1
    fi
}

list_apps() {
    if [[ -d "$INSTALL_DIR" ]]; then
        find "$INSTALL_DIR" -maxdepth 1 -type f -name '*.flatpakref' -printf '%f\n' 2>/dev/null || true
    fi
}

update_remotes() {
    remote_list
    [[ -f "$REMOTES_FILE" ]] || return 0
    echo
    while IFS=$'\t' read -r name url; do
        [[ -z "$name" ]] && continue
        echo "==> Checking $name: $url"
        if curl -fsIL --max-time 15 "$url" >/dev/null 2>&1; then
            echo '    OK'
        else
            echo '    unavailable'
        fi
    done < "$REMOTES_FILE"
}

case "${1:-help}" in
    remote-add)
        shift
        if [[ "${1:-}" == flathub && $# -eq 1 ]]; then add_flathub; else remote_add "$@"; fi ;;
    remote-delete|remote-rm) shift; remote_delete "$@" ;;
    remote-list|remotes) remote_list ;;
    search) shift; search_apps "$@" ;;
    info) shift; info_app "$@" ;;
    install) shift; install_app "$@" ;;
    uninstall|remove) shift; uninstall_app "$@" ;;
    list) list_apps ;;
    update) update_remotes ;;
    run)
        shift
        [[ $# -gt 0 ]] || { echo 'flatpak: application ID required' >&2; exit 1; }
        echo "Downloaded reference for $1 would normally be installed and launched by the native Flatpak runtime."
        echo 'This MSYS2 frontend intentionally does not execute Flatpak applications.' ;;
    version|--version|-v) printf 'flatpak (remote frontend) version %s\n' "$VERSION" ;;
    help|--help|-h) usage ;;
    *) echo "flatpak: unknown command: $1" >&2; usage; exit 1 ;;
esac
EOF

    chmod 755 "$pkgdir/usr/bin/flatpak"
}
